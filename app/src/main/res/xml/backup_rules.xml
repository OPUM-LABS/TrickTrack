<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 (API 30) and older (ignored on API 31+, which uses
   data_extraction_rules.xml). See https://developer.android.com/guide/topics/data/autobackup

   Privacy: trip data is location history, so it is never included in Google's cloud backup.
   On these Android versions the same rules also apply to phone-to-phone transfer.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="active_trip_checkpoint.xml" />
    <exclude domain="file" path="logs/" />
    <exclude domain="file" path="osmdroid/" />
</full-backup-content>
